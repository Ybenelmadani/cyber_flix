{
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?route=sitemap"
    },
    {
      "source": "/film/:id",
      "destination": "/api/seo"
    },
    {
      "source": "/serie/:id",
      "destination": "/api/seo"
    },
    {
      "source": "/movie/:id",
      "destination": "/api/seo"
    },
    {
      "source": "/tv/:id",
      "destination": "/api/seo"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|avif|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
